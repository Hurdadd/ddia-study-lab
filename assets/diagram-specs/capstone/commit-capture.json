  "cards": [
    {
      "dot": "violet",
      "title": "Contract",
      "items": [
        "No business API dual write to a broker or vector index.",
        "Connector and broker failures can cause redelivery.",
        "An event can become durable before its source cursor is checkpointed.",
        "The search effect is idempotent, not an atomic DB + Kafka + index transaction."
      ]
    }
