{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Run lifecycle: durable waits and explicit endings",
    "output": "final-project/diagrams/run-lifecycle.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Execution"
    },
    {
      "id": "waiting",
      "label": "Retry / approval"
    },
    {
      "id": "terminal",
      "label": "Terminal state"
    }
  ],
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "Queued",
      "lane": "main",
      "col": 0
    },
    {
      "id": "running",
      "type": "active",
      "label": "Running",
      "lane": "main",
      "col": 1
    },
    {
      "id": "finalize",
      "type": "decision",
      "label": "Finalize",
      "sublabel": "epoch + policy",
      "lane": "main",
      "col": 3
    },
    {
      "id": "done",
      "type": "success",
      "label": "Succeeded",
      "lane": "main",
      "col": 4
    },
    {
      "id": "retry",
      "type": "waiting",
      "label": "Retry Wait",
      "sublabel": "bounded backoff",
      "lane": "waiting",
      "col": 1
    },
    {
      "id": "approval",
      "type": "waiting",
      "label": "Approval Wait",
      "sublabel": "expires / recheck",
      "lane": "waiting",
      "col": 2
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "lane": "terminal",
      "col": 1
    },
    {
      "id": "cancelled",
      "type": "failure",
      "label": "Cancelled",
      "lane": "terminal",
      "col": 2
    }
  ],
  "transitions": [
    {
      "from": "queued",
      "to": "running"
    },
    {
      "from": "running",
      "to": "finalize",
      "label": "complete"
    },
    {
      "from": "finalize",
      "to": "done",
      "label": "valid"
    },
    {
      "from": "running",
      "to": "retry",
      "label": "transient"
    },
    {
      "from": "retry",
      "to": "running",
      "label": "resume"
    },
    {
      "from": "retry",
      "to": "failed",
      "label": "exhausted",
      "variant": "security"
    },
    {
      "from": "running",
      "to": "approval",
      "label": "needs consent",
      "variant": "security"
    },
    {
      "from": "approval",
      "to": "finalize",
      "label": "approved"
    },
    {
      "from": "approval",
      "to": "cancelled",
      "label": "deny / expire",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "State invariants",
      "items": [
        "One logical run_id survives worker replacement.",
        "Every transition atomically checks status, tenant, and owner epoch.",
        "Cancellation from any nonterminal state is a guarded store operation.",
        "An approval never substitutes for current policy checks at execution time."
      ]
    }
  ]
}