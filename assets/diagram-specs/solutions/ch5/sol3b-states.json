{"cards": [{"dot": "cyan", "items": ["Steps move Triggered, Running, Logged, Gate, Done", "The gate pins old histories to their own code version", "Done means every step result is in the durable log"], "title": "Main Path"}, {"dot": "amber", "items": ["A crash returns to Running with the same step id", "Logged results are reused, never re-run", "Spent retry budget ends as Failed"], "title": "Retry"}, {"dot": "rose", "items": ["Irrecoverable failure compensates forward, never rolls back time", "Compensated is terminal: undo done, effects settled", "Order, branch or payload changes ship as a new version"], "title": "Terminal"}], "diagram_type": "lifecycle", "lanes": [{"id": "main", "label": "Step States"}, {"id": "recovery", "label": "Retry + Compensation"}, {"id": "terminal", "label": "Terminal"}], "meta": {"output": "ch5-encoding-evolution/diagrams/sol3b-states.html", "quality_profile": "showcase", "title": "Workflow Invocation States"}, "states": [{"col": 0, "id": "triggered", "label": "Triggered", "lane": "main", "step": "01", "sublabel": "run accepted", "tag": "start", "type": "start"}, {"col": 1, "id": "running", "label": "Running", "lane": "main", "step": "02", "sublabel": "step executing", "tag": "active", "type": "active"}, {"col": 1, "id": "retrying", "label": "Retrying", "lane": "recovery", "sublabel": "same step id", "tag": "retry", "type": "active"}, {"col": 1, "id": "failed", "label": "Failed", "lane": "terminal", "sublabel": "budget spent", "tag": "terminal", "type": "failure"}, {"col": 2, "id": "logged", "label": "Result Logged", "lane": "main", "step": "03", "sublabel": "durable first", "tag": "stored", "type": "neutral"}, {"col": 3, "id": "gate", "label": "Version Gate", "lane": "main", "step": "04", "sublabel": "v1 history: v1 code", "tag": "gate", "type": "decision"}, {"col": 3, "id": "compensating", "label": "Compensating", "lane": "recovery", "sublabel": "undo forward", "tag": "saga", "type": "active"}, {"col": 3, "id": "compensated", "label": "C