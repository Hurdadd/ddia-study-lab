  {
   "dot": "amber",
   "items": [
    "COUNT(*) twice in one RC transaction: 2, then 3 after a rival INSERT",
    "REPEATABLE READ re-reads the start snapshot: stable at 2",
    "Predicates, not just rows, need protection"
   ],
   "title": "Phantom"
  },
  {
   "dot": "rose",
   "items": [
    "Both snapshots contain {Alice, Bob}: each sees cover and goes off call",
    "On-call set ends EMPTY: the >=1 invariant breaks under SI",
    "At SERIALIZABLE one transaction gets 40001 and retries whole"
   ],
   "title": "Write skew"
  },
  {
   "dot": "emerald",
   "items": [
    "PG snapshot isolation already stops phantoms on re-read",
    "Write skew survives SI: only serializability (or explicit locks) stops it",
    "Name the product AND the version: PG 18, not the SQL minimum"
   ],
   "title": "Product vs standard"
  }
 ],
