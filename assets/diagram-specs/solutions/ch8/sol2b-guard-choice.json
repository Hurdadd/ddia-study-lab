 "cards": [
  {
   "dot": "emerald",
   "items": [
    "Check and INSERT share one transaction behind one guard",
    "The guard is a lock on an existing row or a constraint on the write",
    "Refusal (409) is an answer, not a failure"
   ],
   "title": "Guard at the boundary"
  },
  {
   "dot": "amber",
   "items": [
    "UNIQUE fits discrete fixed slots; intervals need overlap, not equality",
    "SERIALIZABLE works but every abort retries the WHOLE transaction",
    "A hot room serializes: budget backoff, jitter and a retry cap"
   ],
   "title": "Know the costs"
  }
