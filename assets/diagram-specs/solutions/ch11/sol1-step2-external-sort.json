{"cards":[{"dot":"cyan","items":["RAM holds one bounded chunk; disk holds every sorted run","A chunk that fits is sorted in memory, written out, forgotten","Total disk traffic is linear in input: read, write runs, merge"],"title":"Disk Is the Memory"},{"dot":"emerald","items":["The k-way merge keeps one line per run in RAM: O(runs), not O(urls)","Equal neighbours arrive adjacent, so counting streams without a table","The job always finishes: it degrades with I/O instead of dying"],"title":"Merge Streams, Never Stores"},{"dot":"amber","items":["The bottleneck moves to sequential disk read and write rates","Bigger chunks mean fewer runs and a cheaper merge: tune, do not guess","Teaching numbers only: report your disk, your cap, your threshold"],"title":"Bottleneck Moves to I/O"}],"diagram_type":"dataflow","flows":[{"classification":"immutable log lines","from":"accesslog","id":"read-log","label":"read log lines","to":"extract","variant":"emphasis"},{"classification":"one URL per line","from":"extract","id":"url-stream","label":"URL stream","to":"chunksort","variant":"emphasis"},{"classification":"bounded chunk leaves RAM","from":"chunksort","id":"spill-runs","label":"sorted runs spill","to":"runfiles","variant":"dashed","labelDx":1,"labelDy":54},{"classification":"segments merged in order","from":"runfiles","id":"merge-segs","label":"merge segments","to":"mergecount","variant":"emphasis"},{"classification":"counted pairs","from":"mergecount","id":"rank-pairs","label":"counted pairs","to":"topk","variant":"emphasis","labelDx":1,"labelDy":25}],"meta":{"output":".archify/dataflow-ch11-sol1-sort-20261014-222101/sol1-step2-external-sort.html","quality_profile":"showcase","title":"External Sort: Same Top-K, Bounded RAM","viewBox":[1080,660]},"nodes":[{"id":"accesslog","label":"access.log","row":1,"stage":0,"sublabel":"immutable input","tag":"teaching log","type":"database"},{"id":"extract","label":"Extract URL","row":1,"stage":1,"sublabel":"field 7 per line","type":"backend"},{"id":"chunksort","label":"Chunk Sort","row":1,"stage":2,"sublabel":"sort a bounded chunk","tag":"fits in RAM","type":"backend"},{"id":"runfiles","label":"Sorted Run Files","row":1,"stage":3,"sublabel":"spill, then merge","type":"database"},{"id":"mergecount","label":"Merge + Count","row":0,"stage":4,"sublabel":"k-way merge, count runs","type":"backend"},{"id":"topk","label":"Top-K Rank","row":1,"stage":4,"sublabel":"rank, head -n K","type":"backend"}],"schema_version":1,"stages":[{"label":"Source"},{"label":"Extract"},{"label":"Chunk"},{"label":"Runs"},{"label":"Report"}]}