{"cards":[{"dot":"emerald","items":["The barrier waits for every task commit before any pointer moves","A single straggler holds publication: the job is all-or-nothing","Staged files stay invisible while the barrier is open"],"title":"Barrier Before Publish"},{"dot":"amber","items":["Local filesystems publish with an atomic rename of the pointer","Object stores publish with a conditional write or versioned pointer","Never assume rename semantics transfer: match the atom to the store"],"title":"Storage Picks the Atom"},{"dot":"cyan","items":["Readers resolve CURRENT once and read only that manifest","Concurrent publishers race on the pointer: one CAS winner, one retry","Old versions serve pinned readers until garbage collection"],"title":"Readers Never See Half"}],"diagram_type":"workflow","edges":[{"from":"start","id":"freeze-shards","label":"freeze shards","to":"run","variant":"emphasis"},{"from":"run","id":"write-attempts","label":"write attempts","to":"staged","variant":"emphasis"},{"from":"staged","id":"checksum-fails","label":"checksum fails","role":"error","to":"retry","variant":"security"},{"from":"retry","id":"rewrite-clean","label":"rerun from split","role":"branch","to":"run","variant":"dashed"},{"from":"staged","id":"all-committed","label":"all committed","to":"barrier","variant":"emphasis"},{"from":"barrier","id":"swap-pointer","label":"swap pointer","to":"publish","variant":"emphasis"},{"from":"publish","id":"pointer-live","label":"CURRENT points at v3","to":"pointer","variant":"emphasis"},{"from":"pointer","id":"serve-pinned","label":"read pinned version","to":"pin","variant":"default"},{"from":"pointer","id":"keep-previous","label":"previous kept","to":"oldvers","variant":"dashed"}],"groups":[{"fromCol":3,"id":"publish-gate","label":"Publish gate","lane":"driver","toCol":4,"variant":"emphasis"}],"lanes":[{"id":"driver","label":"Job Driver"},{"id":"workers","label":"Workers"},{"id":"store","label":"Store + Reader"}],"mainPath":["start","run","staged","