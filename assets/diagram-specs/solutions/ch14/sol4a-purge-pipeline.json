{"cards": [{"dot": "emerald", "items": ["One sweep covers record, derived views, log and backups: each copy names its mechanism", "A resweep finds nothing new: purge is idempotent, holds are the only survivors", "Retention days here are illustrative teaching numbers, never legal requirements"], "title": "One sweep, every copy"}, {"dot": "amber", "items": ["Legal hold blocks purge per matter, even past retention", "Tombstones gate every restore: no replay without passing them", "Expiry destroys old backups instead of keeping them just in case", "The event log takes an appended tombstone and compacts it away"], "title": "Two guards"}, {"dot": "rose", "items": ["Aggregates are not automatically anonymous: small cells are suppressed", "Audit carries hashes of ids, never raw personal data", "Breach exposure is read off the real inventory, including what was never collected"], "title": "Aggregates and audit"}], "diagram_type": "dataflow", "flows": [{"classification": "expired rows", "from": "record", "id": "record-expired", "label": "expired rows", "to": "sweeper", "variant": "emphasis", "labelDy": -16, "route": "top-channel"}, {"classification": "derived keys", "from": "views", "id": "views-purge", "label": "purge keys", "to": "sweeper", "route": "straight"}, {"classification": "hold list", "from": "hold", "id": "hold-list", "label": "hold list", "to": "sweeper", "variant": "security", "labelDy": -30}, {"classification": "deletion proof", "from": "sweeper", "id": "tombstone-ids", "label": "tombstone ids", "to": "tomb", "variant": "emphasis", "route": "straight", "labelDy": -16}, {"classification": "retention expiry", "from": "sweeper", "id": "expire-backups", "label": "expire + destroy", "to": "backups", "variant": "security", "labelDy": 16}, {"classification": "counts only", "from": "record", "id": "counts-only", "label": "counts only", "to": "aggs", "route": "straight", "labelDy": 16}, {"classification": "evidence", "from": "tomb", "id": "hash-receipts", "label": "hash receipts", "to": "audit", "variant": "dashed", "route": "straight", "labelDy": -16}, {"classification": "gated replay", "from": "backups", "id": "replay-gated", "label": "skips deleted", "to": "restore", "variant": "security"}], "meta": {"output": "ch14-doing-right/diagrams/sol4a-purge-pipeline.html", "quality_profile": "showcase", "title": "Ch14 Sol4a: retention sweep across every copy", "viewBox": [990, 620]}, "nodes": [{"id": "record", "label": "Order record", "row": 0, "stage": 0, "sublabel": "system of record", "tag": "retain 365d*", "type": "database"}, {"id": "views", "label": "Cache + index", "row": 1, "stage": 0, "sublabel": "derived views", "tag": "purge keys", "type": "database"}, {"id": "sweeper", "label": "Retention sweeper", "row": 1, "stage": 1, "sublabel": "periodic purge job", "tag": "idempotent", "type": "backend"}, {"id": "hold", "label": "Legal hold", "row": 2, "stage": 1, "sublabel": "blocks purge", "tag": "per matter", "type": "security"}, {"id": "tomb", "label": "Tombstone log", "row": 1, "stage": 2, "sublabel": "log tombstones + watermarks", "tag": "restore reads it", "type": "database"}, {"id": "backups", "label": "Backups", "row": 2, "stage": 2, "sublabel": "expire by retention", "tag": "destroy, not keep", "type": "database"}, {"id": "aggs", "label": "Aggregates", "row": 0, "stage": 3, "sublabel": "k>=5 or suppress", "tag": "not auto-anonymous", "type": "backend"}, {"id": "audit", "label": "Audit log", "row": 1, "stage": 3, "sublabel": "hashes, no raw PII", "tag": "traceable", "type": "security"}, {"id": "restore", "label": "Restore gate", "row": 2, "stage": 3, "sublabel": "replay skips tombstoned", "tag": "no resurrection", "type": "backend"}], "schema_version": 1, "stages": [{"label": "Stores"}, {"label": "Purge job"}, {"label": "Deletion proof"}, {"label": "Governed ends"}]}