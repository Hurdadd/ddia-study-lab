{"activations": [{"from": 155, "participant": "svc", "to": 474, "type": "backend"}, {"from": 183, "participant": "store", "to": 390, "type": "database"}, {"from": 267, "participant": "budget", "to": 306, "type": "messagebus"}], "cards": [{"dot": "rose", "items": ["Timeout means silence, not failure: the effect may already exist", "Three indistinguishable cases: lost request, dead server, lost reply", "Only the server's result log can tell them apart"], "title": "Unknown outcome"}, {"dot": "emerald", "items": ["Retry carries the SAME request ID and the SAME payload", "The server looks the ID up first and returns the stored result", "Repeats collapse into one effect — no double charge"], "title": "Same-ID retry"}, {"dot": "orange", "items": ["Every retry charges the budget and waits backoff plus jitter", "Three layers times three attempts each: at most 27 downstream tries", "Same ID with a NEW payload is rejected, never applied"], "title": "Bounded layers"}], "diagram_type": "sequence", "messages": [{"from": "client", "id": "send", "label": "send req-7, payload P", "note": "one caller intent, one ID", "to": "svc", "variant": "emphasis", "y": 160}, {"from": "svc", "id": "apply", "label": "apply P, record result", "to": "store", "variant": "default", "y": 188}, {"from": "store", "id": "applied", "label": "applied counter=1", "to": "svc", "variant": "return", "y": 216}, {"from": "svc", "id": "lost", "label": "reply lost in network", "note": "client sees only timeout: UNKNOWN", "to": "client", "variant": "dashed", "y": 244}, {"from": "client", "id": "ask", "label": "retry? attempts left?", "note": "deadline plus budget gate", "to": "budget", "variant": "dashed", "y": 272}, {"from": "budget", "id": "grant", "label": "attempt 2 of 3, wait backoff+jitter", "to": "client", "variant": "return", "y": 300}, {"from": "client", "id": "retry", "label": "retry SAME req-7, same P", "note": "never a fresh ID", "to": "svc", "variant": "emphasis", "y": 328}, {"from": "svc", "id": "lookup", "label": "lookup req-7", "to": "store", "variant": "default", "y": 356}, {"from": "store", "id": "found", "label": "found: counter=1", "to": "svc", "variant": "return", "y": 384}, {"from": "svc", "id": "stored", "label": "stored result, one effect", "note": "no double charge", "to": "client", "variant": "return", "y": 412}, {"from": "client", "id": "reuse", "label": "reuse req-7 with payload Q", "to": "svc", "variant": "dashed", "y": 440}, {"from": "svc", "id": "reject", "label": "reject: ID bound to P", "note": "same ID plus new payload is an error", "to": "client", "variant": "security", "y": 468}], "meta": {"column_fit": "fixed", "output": "ch9-distributed-trouble/diagrams/sol1-step1-timeout-outcomes.html", "quality_profile": "showcase", "title": "Timeout Outcomes: Unknown Result, Same-ID Retry, Payload Binding"}, "participants": [{"id": "client", "label": "Client", "sublabel": "bounded retries", "type": "external"}, {"id": "svc", "label": "Service", "sublabel": "idempotent handler", "type": "backend"}, {"id": "store", "label": "Result Log", "sublabel": "ID to result", "type": "database"}, {"id": "budget", "label": "Retry Budget", "sublabel": "backoff plus jitter", "type": "messagebus"}], "schema_version": 1, "segments": [{"from": 150, "label": "Ambiguous timeout", "to": 250}, {"from": 262, "label": "Same-ID retry", "to": 418}, {"from": 430, "label": "Payload binding", "to": 474}]}