 "cards": [
  {
   "dot": "rose",
   "items": [
    "Crash between apply and commit leaves no trace; ordered replay re-applies and converges",
    "A lost ack only redelivers already-checkpointed offsets, which the guard skips",
    "Both cases are harmless for the same reason: the checkpoint moves only with the effect"
   ],
   "title": "Redelivery is harmless"
  },
  {
   "dot": "emerald",
   "items": [
    "Ownership moves as revoke, abort, then assign with a bumped epoch",
    "The new owner resumes strictly from the committed checkpoint, never from a guess",
    "Exactly-once here means effectively-once inside these three boundaries"
   ],
   "title": "Ordered resume"
  },
  {
   "dot": "orange",
   "items": [
    "A presumed-dead owner may still be alive and writing; epoch mismatch rejects it",
    "Without fencing, two writers interleave totals and checkpoints and silently corrupt",
    "Fencing is a write-path condition, not an optimization"
   ],
   "title": "Fence the stale"
  }
 ],
