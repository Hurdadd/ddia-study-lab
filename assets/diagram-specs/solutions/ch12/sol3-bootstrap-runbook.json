{"cards":[{"dot":"emerald","items":["Photograph first at a recorded LSN, then read the diary written after the photo","The snapshot never touches the leader directly: replica source plus a bounded read rate","Streaming dedup by event id makes the snapshot overlap harmless by construction"],"title":"Photo then diary"},{"dot":"amber","items":["A kill mid-bootstrap is the acceptance test, not an accident: resume and re-checksum","An LSN gap older than WAL retention means re-snapshot; the pipeline says so out loud","A dropped internal column changes nothing downstream while the outbox contract holds"],"title":"Prove freshness"},{"dot":"rose","items":["A purged outbox is a diary with torn-out pages: it can never seed a newcomer","The compacted entity-state topic or a fresh snapshot are the only full-state sources","Tombstones must survive compaction long enough for every follower to observe deletes"],"title":"Purged is not seed"}],"diagram_type":"workflow","edges":[{"from":"snap","label":"bounded rate","role":"main","to":"boundary"},{"from":"boundary","label":"LSN B fixed","role":"main","to":"stream"},{"from":"stream","label":"events after B","role":"main","to":"dedup"},{"from":"dedup","label":"new only","role":"main","to":"verify"},{"from":"verify","label":"checksums equal","role":"main","to":"serve"},{"from":"snap","label":"budget exceeded","role":"error","to":"throttle","variant":"security"},{"from":"stream","label":"LSN expired","role":"error","to":"gap","variant":"security"},{"from":"dedup","label":"kill mid-work","role":"error","to":"kill","variant":"security"},{"from":"verify","label":"column dropped","role":"branch","to":"schema","variant":"dashed"},{"from":"verify","label":"outbox purged","role":"branch","to":"purge","variant":"dashed"}],"groups":[],"lanes":[{"id":"prep","label":"Snapshot"},{"id":"stream","label":"Catch-up"},{"id":"verify","label":"Acceptance"},{"id":"exceptions","label":"Repair + Throttle","variant":"exception"}],"mainPath":["snap","boundary","stream","dedup","verify","serve"],"meta":{"output":"ch12-stream-processing/diagrams/sol3-bootstrap-runbook.html","quality_profile":"showcase","title":"Index bootstrap runbook: snapshot, catch up, prove it"},"nodes":[{"col":0,"id":"snap","label":"Throttled snapshot","lane":"prep","sublabel":"replica + rate cap","type":"database","width":160},{"col":1,"id":"boundary","label":"Record LSN B","lane":"prep","sublabel":"snapshot boundary","type":"security","width":150},{"col":2,"id":"stream","label":"Stream from B","lane":"stream","sublabel":"outbox events","type":"messagebus","width":150},{"col":3,"id":"dedup","label":"Event-ID dedup","lane":"stream","sublabel":"skip overlap","type":"backend","width":150},{"col":4,"id":"verify","label":"Checksum at B'","lane":"verify","sublabel":"index vs record","type":"backend","width":150},{"col":5,"id":"serve","label":"Serve reads","lane":"verify","sublabel":"lag near zero","type":"external","width":130},{"col":0,"id":"throttle","label":"Throttle guard","lane":"exceptions","sublabel":"slow the read","type":"security","width":140},{"col":2,"id":"gap","label":"LSN gap","lane":"exceptions","sublabel":"re-snapshot","type":"security","width":130},{"col":3,"id":"kill","label":"Kill test","lane":"exceptions","sublabel":"resume + recheck","type":"security","width":140},{"col":4,"id":"schema","label":"Column dropped","lane":"exceptions","sublabel":"contract holds","type":"backend","width":140},{"col":5,"id":"purge","label":"Outbox purged","lane":"exceptions","sublabel":"state topic or re-snap","type":"backend","width":160}],"phases":[{"fromCol":0,"id":"photo","label":"Photograph","toCol":1},{"fromCol":2,"id":"diary","label":"Diary","toCol":3,"variant":"emphasis"},{"fromCol":4,"id":"prove","label":"Prove it","toCol":5,"variant":"dashed"}],"schema_version":2}