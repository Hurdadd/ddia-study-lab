 "cards": [
  {
   "dot": "cyan",
   "items": [
    "Four base shards own records by id; two index shards own postings by hashed term",
    "The router holds both maps: id to base shard, term to index shard",
    "The outbox relay carries versioned index writes asynchronously; crashes replay it"
   ],
   "title": "Topology"
  },
  {
   "dot": "emerald",
   "items": [
    "Local write: one base shard, index entry in the same commit",
    "Global write: base commit plus one outbox event per term, applied to each owning index shard",
    "One record, two terms: up to 3 shards written — count base and index shards separately"
   ],
   "title": "Write path"
  },
  {
   "dot": "rose",
   "items": [
    "Single-term reads stay cheap globally (1 index shard); local reads always scatter to 4",
    "Two-term AND intersects postings over the network, then fetches records by id",
    "Every id is revalidated against its base shard: a recorded delete always beats a stale posting"
   ],
   "title": "Read path and tripwires"
  }
 ],
