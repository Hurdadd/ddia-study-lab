{"cards": [{"dot": "cyan", "items": ["120k synthetic writes: 51 sensors over 30 days, sensor-0 hot at 40% — teaching numbers, not benchmarks", "Measure two loads, not one: the month total hides the instantaneous hotspot on today's shard", "Timestamp-range looks even monthly (max share ~13%) yet 100% of one day lands on one shard"], "title": "Read the measurements"}, {"dot": "emerald", "items": ["sensor:timestamp keeps one sensor's month in one shard: fan-out 1, but the hot sensor owns ~47% of a shard", "hash(sensor_id) spreads sensors evenly yet keeps one shard per sensor read — at the price of a full-shard scan", "hash(full key) spreads writes perfectly (~13% max) but a one-sensor month fans out to all 8 shards"], "title": "Write skew versus read fan-out"}, {"dot": "rose", "items": ["A 40% sensor breaks every static key: split it with a 00..99 suffix; writes spread, reads merge 100 sub-counters", "Repartition by splitting the hot range, never by rehashing everything; drop whole old months by retention", "Tripwire: alert when one shard's instantaneous share crosses 3x the mean"], "title": "Hotspot guard and retention"}], "diagram_type": "workflow", "edges": [{"from": "start", "id": "start-q1", "label": "one month of sensors", "role": "main", "to": "q1", "variant": "emphasis"}, {"from": "q1", "id": "q1-sensorts", "label": "yes", "role": "branch", "to": "sensorts", "variant": "default"}, {"from": "q1", "id": "q1-q2", "label": "no", "role": "main", "to": "q2", "variant": "emphasis"}, {"from": "q2", "id": "q2-split", "label": "yes", "role": "branch", "to": "split", "variant": "default"}, {"from": "q2", "id": "q2-q3", "label": "no", "role": "main", "to": "q3", "variant": "emphasis"}, {"from": "q3", "id": "q3-full", "label": "yes", "role": "branch", "to": "full", "variant": "default"}, {"from": "q3", "id": "q3-byname", "label": "no", "role": "main", "to": "byname", "variant": "emphasis"}], "lanes": [{"id": "decide", "label": "Decision"}, {"id": "range", "label": "Key Rang