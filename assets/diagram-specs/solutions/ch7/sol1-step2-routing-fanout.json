 "cards": [
  {
   "dot": "cyan",
   "items": [
    "The write path appends each reading to its sensor's owning shard: owner = sensor id modulo 8",
    "A one-sensor month is a single range scan on one shard: fan-out 1, no merge step",
    "The price sits on the hot sensor: 40% of all writes land on one shard, visible in the day-15 column"
   ],
   "title": "The chosen path: sensor:timestamp"
  },
  {
   "dot": "emerald",
   "items": [
    "Hashing the full key spreads every write evenly: monthly max share near 13%, day-15 near 13%",
    "Ordering is lost, so one sensor's month becomes 8 point-lookup batches across all shards",
    "Choose it when writes dominate and per-sensor scans are rare; otherwise the merge cost eats the win"
   ],
   "title": "The scattered alternative: hash(full key)"
  },
  {
   "dot": "rose",
   "items": [
    "Monthly totals hide instantaneous skew: timestamp-range looks even yet takes 100% of today on one shard",
    "Retention drops whole old months; repartition splits the hot range instead of rehashing the world",
    "Alert when one shard's instantaneous share passes 3x the mean"
   ],
   "title": "Measure both clocks"
  }
 ],
