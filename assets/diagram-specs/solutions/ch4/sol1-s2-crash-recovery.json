  "cards": [
    {
      "dot": "emerald",
      "items": [
        "The ack goes out only after the WAL fsync, never after the RAM update",
        "The manifest record is the commit point: only listed files serve reads",
        "Restart replays checksummed WAL records and drops the corrupt tail"
      ],
      "title": "Durability order"
    },
    {
      "dot": "rose",
      "items": [
        "The flushed-but-unlisted file is ignored, never half-served",
        "No reader ever sees state between the flush and the manifest record",
        "Replay rebuilds exactly the acknowledged prefix"
      ],
      "title": "Crash window"
    }
  ],
