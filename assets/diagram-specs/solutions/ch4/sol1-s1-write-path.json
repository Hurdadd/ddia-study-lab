{
  "cards": [
    {
      "dot": "emerald",
      "items": [
        "Every write is a sequential append: first the WAL fsync, then the memtable update",
        "The ack goes out only after the fsync, never after the RAM update alone",
        "Flush turns a full memtable into one immutable SSTable, the newest segment"
      ],
      "title": "Append-only writes"
    },
    {
      "dot": "orange",
      "items": [
        "Compaction merges segments and keeps the newest version per key",
        "Tombstones tell the merge to drop older copies of a deleted key",
        "Size-tiered merging favors writes, leveled merging favors reads and space"
      ],
      "title": "Background cleanup"
    }
  ],
