{"cards": [{"dot": "emerald", "items": ["The new view replays shared history, then consumes to the tip", "Only one view serves each read percent; the flag is reversible", "Cutover needs criteria, not courage: mismatches plus lag plus hold time"], "title": "Forward rail"}, {"dot": "amber", "items": ["Shadow compares every read while serving zero live percent", "Canary grows 5 to 50 to 100 only while mismatches stay zero", "Lag has a bound; an unbounded new view never cutsover"], "title": "Gates that hold"}, {"dot": "rose", "items": ["Rollback is a real state: one flag flip back to the old view", "The old view keeps serving until retirement, so rollback is instant", "After a fix the migration re-enters at canary, never at cutover"], "title": "Rollback is a state"}], "diagram_type": "lifecycle", "lanes": [{"id": "main", "label": "Migration rail"}, {"id": "gates", "label": "Gates + shadow"}, {"id": "recovery", "label": "Rollback path"}, {"id": "terminal", "label": "Terminal exits"}], "meta": {"output": "ch13-streaming-philosophy/diagrams/sol2-step1-view-states.html", "quality_profile": "showcase", "title": "Dual-view migration states"}, "schema_version": 2, "states": [{"col": 0, "id": "backfill", "label": "Backfill", "lane": "main", "step": "01", "sublabel": "replay history", "tag": "bulk", "type": "start"}, {"col": 1, "id": "catchup", "label": "CatchUp", "lane": "main", "step": "02", "sublabel": "reach the tip", "tag": "streaming", "type": "active"}, {"col": 1, "id": "shadow", "label": "Shadow", "lane": "gates", "step": "03", "sublabel": "0% live, compare", "tag": "gate", "type": "waiting"}, {"col": 2, "id": "canary", "label": "Canary", "lane": "main", "step": "04", "sublabel": "growing live reads", "tag": "percent", "type": "active"}, {"col": 3, "id": "cutover", "label": "Cutover", "lane": "main", "step": "05", "sublabel": "criteria met?", "tag": "decision", "type": "decision"}, {"col": 3, "id": "rollback", "label": "Rollback", "lane": "recovery", "step": "06", "subla