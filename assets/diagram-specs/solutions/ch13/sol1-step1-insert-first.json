 "cards": [
  {
   "dot": "emerald",
   "items": [
    "INSERT of request_id is the FIRST statement inside the transfer transaction",
    "UNIQUE(request_id) turns a retry into a key conflict, not a second transfer",
    "Debit, credit and the input-log row commit atomically with the request row"
   ],
   "title": "INSERT-first"
  },
  {
   "dot": "rose",
   "items": [
    "The commit succeeded but the 200 OK never reached the client",
    "The retry carries the SAME id with the SAME payload",
    "The API returns the STORED result; balances do not move again"
   ],
   "title": "Lost reply + retry"
  },
  {
   "dot": "orange",
   "items": [
    "Same id with a DIFFERENT payload is rejected, never applied",
    "Same payload with a NEW id is an independent intentional transfer",
    "Payload hash stored beside the id makes the comparison exact"
   ],
   "title": "Payload binding"
  }
 ],
