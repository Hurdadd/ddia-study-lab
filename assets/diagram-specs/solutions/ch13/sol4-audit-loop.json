{"cards": [{"dot": "emerald", "items": ["Both the derivation and the checker read the same authoritative log", "The checker uses separate code and stops at a stated checkpoint", "Expected state comes from replay, never from the live database"], "title": "Same log, separate code"}, {"dot": "amber", "items": ["Actual state is read at the same checkpoint, then compared", "Behind but consistent means lag: track it, do not page it", "Same-checkpoint difference means corruption: page it"], "title": "Compare at one point"}, {"dot": "rose", "items": ["Mismatch pages a human; repair never runs on detection alone", "Lag gets a board and a bound; corruption gets an incident", "Shared bugs and incomplete logs stay outside the proof: say so"], "title": "Detection is not repair"}], "diagram_type": "dataflow", "flows": [{"classification": "independent path", "from": "inputlog", "id": "replay", "label": "replay", "to": "checker", "variant": "emphasis"}, {"classification": "audited path", "from": "inputlog", "id": "derive", "label": "derivation", "to": "livedb", "variant": "dashed"}, {"classification": "recomputed", "from": "checker", "id": "expected", "label": "expected", "to": "verdict", "variant": "default"}, {"classification": "read state", "from": "livedb", "id": "actual", "label": "actual", "to": "verdict", "variant": "default"}, {"classification": "corruption", "from": "verdict", "id": "page", "label": "mismatch", "to": "pager", "variant": "emphasis"}, {"classification": "behind, not corrupt", "from": "verdict", "id": "lag", "label": "lag", "to": "lagboard", "variant": "dashed"}], "meta": {"output": "ch13-streaming-philosophy/diagrams/sol4-audit-loop.html", "quality_profile": "showcase", "title": "End-to-end audit loop"}, "nodes": [{"id": "inputlog", "label": "Input log", "row": 1, "stage": 0, "sublabel": "authoritative", "tag": "shared", "type": "messagebus"}, {"id": "checker", "label": "Checker", "row": 0, "stage": 1, "sublabel": "separate code", "tag": "to checkpoint", "type": "backend"}, {"id": "livedb", "label": "Live state", "row": 2, "stage": 1, "sublabel": "same checkpoint", "tag": "under audit", "type": "database"}, {"id": "verdict", "label": "Verdict", "row": 1, "stage": 2, "sublabel": "one checkpoint", "tag": "compare", "type": "backend"}, {"id": "pager", "label": "Page human", "row": 0, "stage": 3, "sublabel": "mismatch only", "tag": "incident", "type": "backend"}, {"id": "lagboard", "label": "Lag board", "row": 2, "stage": 3, "sublabel": "bound + trend", "tag": "no page", "type": "backend"}], "schema_version": 1, "stages": [{"label": "Source"}, {"label": "Recompute"}, {"label": "Verdict"}, {"label": "Respond"}]}