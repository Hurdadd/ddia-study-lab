  {
   "dot": "emerald",
   "items": [
    "Fresh input enters only through the INSERT-first transaction",
    "UNIQUE(request_id), debit, credit and the log row commit together",
    "One atomic append per request; everything downstream replays it"
   ],
   "title": "One atomic write"
  },
  {
   "dot": "rose",
   "items": [
    "A lost reply never means a lost commit: retry reuses the same id",
    "Same id plus same payload returns the stored result, moving nothing",
    "Same id plus new payload is rejected; new id plus same payload is allowed"
   ],
   "title": "Lost-reply discipline"
  },
  {
   "dot": "orange",
   "items": [
    "The balance view is rebuilt from the log alone, by separate code",
    "Replay must equal live state; any gap is a bug, not lag",
    "Lag is bounded and measured; silent divergence is corruption"
   ],
   "title": "Independent replay"
  }
 ],
